# Supabase (local dev, run by `supabase start`)
#
# Auth keys are NOT committed here: newer Supabase CLIs generate per-instance
# signing keys, so the anon/service_role values differ on every machine.
# `make up` reads the live keys from `supabase start` and injects them
# automatically (see scripts/supabase-env.sh) -- you do NOT need to fill these in.
# They only matter if you bypass make and run `docker compose up` directly, in
# which case run `make supabase-status` and paste the real values here.
#
# Two URLs intentionally differ by run context:
#   SUPABASE_URL       -> used by the Temporal worker, which runs INSIDE Docker and
#                         reaches the host-bound Supabase via host.docker.internal.
#   VITE_SUPABASE_URL  -> used by the frontend, which runs in the browser on the HOST.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=injected-by-make-up
SUPABASE_SERVICE_ROLE_KEY=injected-by-make-up

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=main

# Web search (Temporal worker). SEARCH_PROVIDER selects the backend by name;
# SEARCH_FALLBACK_PROVIDER (optional) is tried when the primary fails.
# Available providers: tavily. Free key (no card): https://app.tavily.com
SEARCH_PROVIDER=tavily
SEARCH_FALLBACK_PROVIDER=
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT_SECONDS=15
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# AWS Bedrock (Temporal worker). The worker exits at startup unless Bedrock
# (BEDROCK_ENDPOINT_URL + AWS_REGION) or LiteLLM (below) is configured. Model IDs are NOT set here: admins manage
# them in the admin portal (llm_models). Never commit real AWS keys.
BEDROCK_ENDPOINT_URL=https://bedrock-runtime.us-east-1.amazonaws.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional: creates the first enabled + default llm_models row on a fresh install.
BEDROCK_BOOTSTRAP_MODEL_ID=

# LiteLLM proxy (Temporal worker), for llm_models rows with provider = 'litellm'.
# Full Anthropic Messages URL, e.g. https://<proxy-host>/v1/messages. Never commit real keys.
LITELLM_MESSAGES_URL=
LITELLM_API_KEY=

# Amazon product API (optional). Without these, Amazon uses site-scoped search + page fetch.
AMAZON_API_ACCESS_KEY=
AMAZON_API_SECRET_KEY=
AMAZON_PARTNER_TAG=

# FX rates: free, no key (ExchangeRate-API open access, fawazahmed0 fallback).
FX_RATES_PROVIDER=exchangerate_api_open
FX_RATES_FALLBACK_PROVIDER=fawazahmed0

# Headless renderer sidecar (docker compose service `renderer`).
HEADLESS_RENDERER_URL=http://renderer:3001

# Outbox dispatcher and per-run scout budgets (split across retailers).
JOB_POLL_INTERVAL_SECONDS=2
JOB_CLAIM_BATCH_SIZE=10
SCOUT_MAX_ITERATIONS=12
SCOUT_MAX_FETCHES=25
SCOUT_MAX_TOKENS=60000

# Google OAuth (Supabase Auth, referenced from supabase/config.toml via env()).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Frontend (browser on the host -> localhost)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=injected-by-make-up
VITE_API_URL=http://localhost:54321/functions/v1
# Dev-only: show an email/password login form (local Supabase keeps email sign-in
# enabled for this). Leave false anywhere real users sign in -- Google is the only
# supported sign-in method.
VITE_ENABLE_DEV_LOGIN=false
